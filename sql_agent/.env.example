# Create sql_agent/.env from this file and replace the placeholder.
HF_TOKEN=hf_your_token_here

# Optional: select another Hugging Face chat model with tool-calling support.
HF_MODEL=Qwen/Qwen3.8-27B
HF_MAX_OUTPUT_TOKENS=2048
# Use ollama after pulling OLLAMA_MODEL and starting its local server.
LLM_PROVIDER=huggingface
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_TIMEOUT_SECONDS=180

# Maximum extra agent attempts requested by the LLM answer reviewer (0-3).
HF_REVIEW_MAX_RETRIES=2
