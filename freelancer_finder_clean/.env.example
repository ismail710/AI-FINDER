# Copy this file to .env. Never commit the real token.
# HF_TOKEN is used for sentence-transformer query/profile embeddings.
HF_TOKEN=hf_your_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local chat/planning model. Hugging Face can also be selected here.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_TIMEOUT_SECONDS=180
PLANNER_MAX_OUTPUT_TOKENS=768
REVIEW_MAX_OUTPUT_TOKENS=1024

# Used only when LLM_PROVIDER=huggingface.
HF_MODEL=Qwen/Qwen3.8-27B
HF_TIMEOUT_SECONDS=90
HF_MAX_OUTPUT_TOKENS=2048
HF_RECURSION_LIMIT=12
HF_REVIEW_MAX_RETRIES=2
